# Copy to .env for local development. Never commit .env.
# In production these come from the host's secret manager, not from a file (P2.O03).

DATABASE_URL=postgres://viking:viking@localhost:5432/viking
REDIS_URL=redis://localhost:6379

# Signs every session token. The server refuses to start in production if this is still the
# development value or shorter than 24 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=dev-secret-change-me

PORT=3000
NODE_ENV=development

# Open a kingdom on first boot when none exists, so a fresh deploy is playable. Set false if you
# want to create kingdoms by hand.
AUTO_OPEN_KINGDOM=true
KINGDOM_SIZE=600

# Requests per minute, per player token (or per address when signed out).
RATE_LIMIT_PER_MINUTE=300
